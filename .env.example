# Supabase, for docker-compose.yml. Copy to .env.
#
# Project settings, API. The URL is the project's base URL, without /rest/v1/:
# the page adds that itself.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Public by design: RLS in supabase/migrations makes it read-only.
SUPABASE_ANON_KEY=

# The chain the wall reads (1 mainnet).
ZNN_CHAIN_ID=1
