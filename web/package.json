{
  "name": "zenon-wall-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Zenon Wall — messages written on the Network of Momentum. Static SPA for GitHub Pages.",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,vue,css}\""
  },
  "dependencies": {
    "@lucide/vue": "^1.20.0",
    "@vueuse/core": "^14.2.0",
    "nom-ui": "github:digitalSloth/nom-ui",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@types/chrome": "^0.0.260",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.4",
    "@vue/eslint-config-typescript": "^14.6.0",
    "eslint": "^9.39.2",
    "eslint-plugin-vue": "^10.7.0",
    "prettier": "^3.2.0",
    "tailwindcss": "^4.1.18",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.9.0",
    "vite": "^7.3.1",
    "vue-tsc": "^3.3.3"
  }
}
