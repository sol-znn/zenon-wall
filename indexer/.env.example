# Zenon node HTTP JSON-RPC (port 35997 on a stock node, not the 35998 WebSocket).
ZNN_RPC_URL=https://node.zenonhub.io:35997

# Project settings → API. The service role key bypasses RLS: keep it on the
# indexer host / in a CI secret, never in the web app.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# First momentum scanned on an empty database. The first ZW message on mainnet
# is at 1341650 (2022-05-04); nothing earlier can match.
START_HEIGHT=1341000

# Stay this many momentums behind the frontier before indexing.
CONFIRMATIONS=6

# Momentums per RPC call (node maximum 1024) and calls fetched in parallel.
BATCH_SIZE=1024
CONCURRENCY=4

# Seconds between checks once caught up (ignored with --once).
POLL_SECONDS=30
