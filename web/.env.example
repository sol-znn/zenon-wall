# Supabase → Project settings → API. The anon key is public by design: the
# row-level security policies in supabase/migrations are what make it read-only.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=

# Messages per page.
VITE_PAGE_SIZE=10

# The chain this wall reads (1 mainnet). Posting from a wallet on any other
# chain is refused.
VITE_ZNN_CHAIN_ID=1

# Explorer links: zenonhub | none. zenonhub on mainnet, none elsewhere.
# VITE_EXPLORER=
